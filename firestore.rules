rules_version = '2';

// Security rules per il Fantacalcio Manageriale.
//
// Modello di accesso:
//  - LETTURA: aperta a tutti (nessuna autenticazione richiesta)
//  - SCRITTURA, risorsa per risorsa:
//    * isAdmin(): SOLO l'account admin (login email/password condiviso della
//      lega). Tutti i dati sensibili: rose, finanze, lega, svincolati,
//      conferma delle trattative di scambio.
//    * isAuthenticated(): include anche i partecipanti ANONIMI dell'asta.
//      Usato solo dove serve davvero: rilanci sull'asta e creazione voci
//      di auditLog.
//
// NOTA STORICA: prima dell'introduzione del login anonimo per l'asta,
// "autenticato" coincideva con "admin"; oggi non più, quindi ogni regola
// di scrittura distingue esplicitamente i due livelli.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Admin = autenticato con l'account email/password CONDIVISO della lega
    // (environment.adminEmail — se cambia lì, va cambiato anche qui), OPPURE
    // un account squadra il cui uid è tra quelli con permessi admin estesi
    // (environment.legaAdminUids — stesso identico elenco, i due file vanno
    // tenuti in sync a mano: non c'è un modo per far leggere le rules
    // dall'environment). Da quando esistono anche gli account squadra
    // (email/password ma con email diversa), non basta più "autenticato con
    // password": va verificata anche l'identità, altrimenti ogni squadra
    // risulterebbe admin.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && (request.auth.token.email == 'admin@fantamanager.app'
            || request.auth.uid == 'XabixzI9FuhlmlI6ZVUNgZk3aSm2');
    }

    // Proprietario della squadra teamId: account email/password (diverso da
    // quello admin) il cui uid è salvato in teams/{teamId}.ownerUid — scritto
    // SOLO dallo script di provisioning (Admin SDK), mai dal client. A
    // differenza della scelta squadra in asta (client-side, vedi sotto),
    // questa è una verifica vera, lato server.
    function isTeamOwner(teamId) {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && get(/databases/$(database)/documents/teams/$(teamId)).data.ownerUid == request.auth.uid;
    }

    // Lega e sotto-collection (taxBrackets, svincolati): lettura pubblica,
    // scrittura solo admin (dati lega, rose libere)
    match /league/{leagueId} {
      allow read: if true;
      allow write: if isAdmin();

      match /{subcollection}/{document=**} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Squadre e tutte le sottocollezioni annidate (seasons/{stagione}/players,
    // loanedPlayers, seasonFinance, ...): lettura pubblica, scrittura solo
    // admin (CRUD giocatori, prestiti, spese societarie).
    match /teams/{teamId} {
      allow read: if true;
      allow write: if isAdmin();

      match /{subcollection}/{document=**} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Audit log: append-only.
    // - create: chiunque abbia una sessione (admin o anonimi dell'asta);
    //   le azioni fatte senza sessione non generano voci (l'AuditService
    //   non blocca mai l'operazione principale).
    // - update/delete: SEMPRE negato (storico non modificabile).
    match /auditLog/{logId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Asta live: UNICO documento (asta/statoCorrente) usato sia dai rilanci
    // dei partecipanti (anonimi ma autenticati) sia dall'admin per apertura/
    // chiusura/assegnazione. Le rules non possono distinguere le due azioni
    // sul medesimo documento: la scrittura resta ai soli autenticati e la
    // separazione dei ruoli è garantita dalla UI + transaction client-side
    // (prezzo solo crescente). Modello "lega tra amici fidati".
    match /asta/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Trattative di scambio tra squadre. Stati: bozza (PRIVATA, solo le due
    // squadre coinvolte) -> ufficializzata (visibile anche agli admin, che
    // possono confermarla) -> confermata/annullata (pubbliche, come prima).
    //
    // squadraA.ownerUid/squadraB.ownerUid sono una copia di
    // teams/{id}.ownerUid presa al momento della creazione: le query "list"
    // (a differenza di un get() su un doc singolo) possono essere validate
    // dalle rules solo se il filtro corrisponde DIRETTAMENTE a un campo del
    // documento — da qui la copia, invece di una isTeamOwner() con get()
    // indiretta (vedi ScambioSide in models.ts).
    function scambioMioOCoinvolto() {
      return resource.data.squadraA.ownerUid == request.auth.uid
        || resource.data.squadraB.ownerUid == request.auth.uid;
    }

    match /scambi/{scambioId} {
      allow read: if resource.data.stato != 'bozza' || scambioMioOCoinvolto();

      // Creazione: solo una delle due squadre coinvolte, e solo come bozza.
      // Verifica che l'ownerUid dichiarato per ciascun lato corrisponda
      // davvero al proprietario registrato di quella squadra (altrimenti un
      // client potrebbe dichiarare un ownerUid falso per farsi vedere una
      // bozza che non gli appartiene).
      allow create: if request.resource.data.stato == 'bozza'
        && (isTeamOwner(request.resource.data.squadraA.teamId)
            || isTeamOwner(request.resource.data.squadraB.teamId))
        && request.resource.data.squadraA.ownerUid ==
             get(/databases/$(database)/documents/teams/$(request.resource.data.squadraA.teamId)).data.ownerUid
        && request.resource.data.squadraB.ownerUid ==
             get(/databases/$(database)/documents/teams/$(request.resource.data.squadraB.teamId)).data.ownerUid;

      // Aggiornamento: l'admin può tutto (conferma, ecc. — la scrittura vera
      // avviene nel batch atomico di ScambiService, con teams/finanze già
      // protetti a parte). Una delle due squadre coinvolte può SOLO
      // ufficializzare una propria bozza (bozza -> ufficializzata).
      allow update: if isAdmin()
        || (resource.data.stato == 'bozza'
            && request.resource.data.stato == 'ufficializzata'
            && scambioMioOCoinvolto());

      // Eliminazione: solo una bozza propria (mai una già ufficializzata).
      allow delete: if resource.data.stato == 'bozza' && scambioMioOCoinvolto();
    }

    // Valutazioni PRIVATE (stelle 1-3 + note) di una squadra sugli
    // svincolati — vantaggio competitivo personale, non condiviso: solo la
    // squadra proprietaria può leggerle o scriverle. Collection separata
    // apposta (non sotto teams/ o league/, già pubblicamente leggibili da
    // regole più larghe: nidificarle lì le avrebbe rese pubbliche lo stesso).
    match /teamNotes/{teamId} {
      match /{document=**} {
        allow read, write: if isTeamOwner(teamId);
      }
    }

    // Registro delle operazioni annullabili (rinnovo, rimborso/eliminazione,
    // acquisto asta, conferma scambio): scritte SOLO come parte del batch
    // atomico dell'operazione stessa (già admin, vedi sopra), quindi
    // create/update solo admin. Storico immutabile: nessuna delete.
    match /undoLog/{logId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Configurazioni sensibili (es. hash password future):
    // accessibili solo tramite Admin SDK (Cloud Functions / script)
    match /config/{docId} {
      allow read, write: if false;
    }
  }
}