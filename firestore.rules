rules_version = '2';

// Security rules per il Fantacalcio Manageriale.
//
// Modello di accesso:
//  - LETTURA: aperta a tutti (nessuna autenticazione richiesta)
//  - SCRITTURA: riservata agli autenticati (= chi ha effettuato il login
//    con la password condivisa della lega)
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Lega e scaglioni fiscali: lettura pubblica,
    // scrittura solo per gli admin autenticati
    match /league/{leagueId} {
      allow read: if true;
      allow write: if isAuthenticated();

      match /taxBrackets/{bracketId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }

    // Squadre e sottocollezioni (players, loanedPlayers, seasonFinance,
    // teamFinanceHistory): lettura pubblica, scrittura solo autenticati
    match /teams/{teamId} {
      allow read: if true;
      allow write: if isAuthenticated();

      match /{subcollection}/{document=**} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }

    // Audit log: immutabile.
    // - create: consentito ai client autenticati finché le Cloud Functions
    //   non sono deployate; poi sostituire con:
    //     allow create: if request.auth.uid == 'UID_CLOUD_FUNCTION';
    // - update/delete: sempre negato (storico non modificabile)
    match /auditLog/{logId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Configurazioni sensibili (es. hash password future):
    // accessibili solo tramite Admin SDK (Cloud Functions / script)
    match /config/{docId} {
      allow read, write: if false;
    }
  }
}