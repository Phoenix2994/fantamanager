rules_version = '2';

// Security rules per il Fantacalcio Manageriale.
//
// Modello di accesso:
//  - LETTURA: aperta a tutti (nessuna autenticazione richiesta)
//  - SCRITTURA, risorsa per risorsa:
//    * isAdmin(): SOLO l'account admin (login email/password condiviso della
//      lega). Tutti i dati sensibili: rose, finanze, lega, svincolati,
//      conferma delle trattative di scambio.
//    * isAuthenticated(): include anche i partecipanti ANONIMI dell'asta.
//      Usato solo dove serve davvero: rilanci sull'asta e creazione voci
//      di auditLog.
//
// NOTA STORICA: prima dell'introduzione del login anonimo per l'asta,
// "autenticato" coincideva con "admin"; oggi non più, quindi ogni regola
// di scrittura distingue esplicitamente i due livelli.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Admin = autenticato con email/password (l'account condiviso della lega).
    // I login anonimi (partecipanti all'asta) NON sono admin.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    // Lega e sotto-collection (taxBrackets, svincolati): lettura pubblica,
    // scrittura solo admin (dati lega, rose libere)
    match /league/{leagueId} {
      allow read: if true;
      allow write: if isAdmin();

      match /{subcollection}/{document=**} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Squadre e tutte le sottocollezioni annidate (seasons/{stagione}/players,
    // loanedPlayers, seasonFinance, ...): lettura pubblica, scrittura solo
    // admin (CRUD giocatori, prestiti, spese societarie).
    match /teams/{teamId} {
      allow read: if true;
      allow write: if isAdmin();

      match /{subcollection}/{document=**} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Audit log: append-only.
    // - create: chiunque abbia una sessione (admin o anonimi dell'asta);
    //   le azioni fatte senza sessione non generano voci (l'AuditService
    //   non blocca mai l'operazione principale).
    // - update/delete: SEMPRE negato (storico non modificabile).
    match /auditLog/{logId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Asta live: UNICO documento (asta/statoCorrente) usato sia dai rilanci
    // dei partecipanti (anonimi ma autenticati) sia dall'admin per apertura/
    // chiusura/assegnazione. Le rules non possono distinguere le due azioni
    // sul medesimo documento: la scrittura resta ai soli autenticati e la
    // separazione dei ruoli è garantita dalla UI + transaction client-side
    // (prezzo solo crescente). Modello "lega tra amici fidati".
    match /asta/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Trattative di scambio tra squadre:
    // - lettura e CREAZIONE bozze: aperte a tutti;
    // - aggiornamento (= conferma dell'admin): solo admin;
    // - eliminazione: aperta a tutti MA solo finché è una bozza (stessa
    //   apertura della creazione — una volta confermata/annullata non è
    //   più cancellabile da nessuno).
    match /scambi/{scambioId} {
      allow read, create: if true;
      allow update: if isAdmin();
      allow delete: if resource.data.stato == 'bozza';
    }

    // Registro delle operazioni annullabili (rinnovo, rimborso/eliminazione,
    // acquisto asta, conferma scambio): scritte SOLO come parte del batch
    // atomico dell'operazione stessa (già admin, vedi sopra), quindi
    // create/update solo admin. Storico immutabile: nessuna delete.
    match /undoLog/{logId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Configurazioni sensibili (es. hash password future):
    // accessibili solo tramite Admin SDK (Cloud Functions / script)
    match /config/{docId} {
      allow read, write: if false;
    }
  }
}